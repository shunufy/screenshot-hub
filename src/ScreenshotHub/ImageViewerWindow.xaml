<Window x:Class="ScreenshotHub.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ScreenshotHub.Core;assembly=ScreenshotHub.Core"
        Title="{x:Static core:AppText.ViewerTitle}"
        Foreground="{StaticResource TextBrush}"
        Width="1280"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
        </Grid.RowDefinitions>

        <Border BorderBrush="#202A39" BorderThickness="0,0,0,1" Background="#0D1119">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviousButton"
                        Content="‹"
                        ToolTip="{x:Static core:AppText.PreviousImage}"
                        Click="PreviousButton_Click"
                        Style="{StaticResource IconButton}" />
                <Button x:Name="NextButton"
                        Grid.Column="1"
                        Content="›"
                        Margin="7,0,0,0"
                        ToolTip="{x:Static core:AppText.NextImage}"
                        Click="NextButton_Click"
                        Style="{StaticResource IconButton}" />
                <TextBlock x:Name="PositionText"
                           Grid.Column="2"
                           MinWidth="80"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock x:Name="FileNameText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="4"
                        Content="−"
                        ToolTip="{x:Static core:AppText.ZoomOut}"
                        Click="ZoomOutButton_Click"
                        Style="{StaticResource IconButton}" />
                <TextBlock x:Name="ZoomText"
                           Grid.Column="5"
                           Width="66"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Button Grid.Column="6"
                        Content="＋"
                        ToolTip="{x:Static core:AppText.ZoomIn}"
                        Click="ZoomInButton_Click"
                        Style="{StaticResource IconButton}" />
                <Button Grid.Column="7"
                        Content="{x:Static core:AppText.FitToWindow}"
                        Margin="9,0,0,0"
                        Padding="11,7"
                        Click="FitButton_Click"
                        Style="{StaticResource QuietButton}" />
                <Button Grid.Column="8"
                        Content="{x:Static core:AppText.ActualSize}"
                        Margin="7,0,0,0"
                        Padding="11,7"
                        Click="ActualSizeButton_Click"
                        Style="{StaticResource QuietButton}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14" Background="#05070A" BorderBrush="#202A39" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="ViewerScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              Focusable="True"
                              PreviewMouseWheel="ViewerScrollViewer_PreviewMouseWheel"
                              MouseLeftButtonDown="ViewerScrollViewer_MouseLeftButtonDown"
                              MouseLeftButtonUp="ViewerScrollViewer_MouseLeftButtonUp"
                              MouseMove="ViewerScrollViewer_MouseMove"
                              MouseLeave="ViewerScrollViewer_MouseLeave">
                    <Image x:Name="ViewerImage"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="ViewerScale" ScaleX="1" ScaleY="1" />
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
                <TextBlock x:Name="UnavailableText"
                           Text="{x:Static core:AppText.PreviewUnavailable}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="16"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0D1119" BorderBrush="#202A39" BorderThickness="0,1,0,0">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PathText"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10.5"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="TagsText"
                                   Foreground="{StaticResource AccentStrongBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DuplicateText"
                                   Margin="14,0,0,0"
                                   Foreground="{StaticResource PositiveBrush}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FavoriteButton"
                            MinWidth="42"
                            Content="☆"
                            Click="FavoriteButton_Click"
                            Foreground="#FFE6A8"
                            Style="{StaticResource QuietButton}" />
                    <Button Content="{x:Static core:AppText.EditTags}"
                            Margin="7,0,0,0"
                            Click="EditTagsButton_Click"
                            Style="{StaticResource QuietButton}" />
                    <Button Content="{x:Static core:AppText.ShowInExplorer}"
                            Margin="7,0,0,0"
                            Click="ShowInExplorerButton_Click"
                            Style="{StaticResource QuietButton}" />
                    <Button Content="{x:Static core:AppText.OpenDefaultApp}"
                            Margin="7,0,0,0"
                            Click="OpenDefaultButton_Click"
                            Style="{StaticResource AccentButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
