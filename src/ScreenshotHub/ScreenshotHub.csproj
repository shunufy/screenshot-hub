<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenshotHub</AssemblyName>
    <RootNamespace>ScreenshotHub</RootNamespace>
    <ScreenshotHubLanguage Condition="'$(ScreenshotHubLanguage)' == ''">ja-JP</ScreenshotHubLanguage>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyTitle Condition="'$(ScreenshotHubLanguage)' == 'ja-JP'">スクリーンショット・ハブ</AssemblyTitle>
    <AssemblyTitle Condition="'$(ScreenshotHubLanguage)' == 'en-US'">Screenshot Hub</AssemblyTitle>
    <Product>Screenshot Hub</Product>
    <Description Condition="'$(ScreenshotHubLanguage)' == 'ja-JP'">ゲームのスクリーンショットを読み取り専用で整理・検索・閲覧するWindowsアプリ</Description>
    <Description Condition="'$(ScreenshotHubLanguage)' == 'en-US'">A private read-only Windows gallery for discovering, organizing, searching, and viewing game screenshots.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenshotHub.Core\ScreenshotHub.Core.csproj" />
    <AssemblyMetadata Include="ScreenshotHubLanguage" Value="$(ScreenshotHubLanguage)" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ScreenshotHub.UiSmoke</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="ValidateScreenshotHubLanguage" BeforeTargets="CoreCompile"
          Condition="'$(ScreenshotHubLanguage)' != 'ja-JP' and '$(ScreenshotHubLanguage)' != 'en-US'">
    <Error Text="ScreenshotHubLanguage must be ja-JP or en-US." />
  </Target>
</Project>
