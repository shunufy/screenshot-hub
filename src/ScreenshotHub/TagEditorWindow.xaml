<Window x:Class="ScreenshotHub.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ScreenshotHub.Core;assembly=ScreenshotHub.Core"
        Title="{x:Static core:AppText.EditTags}"
        Width="520"
        Height="260"
        MinWidth="420"
        MinHeight="230"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{x:Static core:AppText.Tags}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="{x:Static core:AppText.TagsHint}"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="TagTextBox"
                 Grid.Row="1"
                 Margin="0,16,0,16"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static core:AppText.Tags}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static core:AppText.Cancel}"
                    MinWidth="92"
                    Margin="0,0,9,0"
                    IsCancel="True"
                    Style="{StaticResource QuietButton}" />
            <Button Content="{x:Static core:AppText.Save}"
                    MinWidth="92"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
